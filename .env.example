# Chaves das suas 3 escolas na Hotscool:
HOTSCOOL_API_KEY_1=sua_chave_escola_1
HOTSCOOL_API_KEY_2=sua_chave_escola_2
HOTSCOOL_API_KEY_3=sua_chave_escola_3

# Portal aberto pelo botao "Continuar Curso". Pode ser substituido pelo
# dominio personalizado da escola, quando houver.
HOTSCOOL_STUDENT_PORTAL_URL=https://app.hotscool.com

# Origens autorizadas no desenvolvimento/produção, separadas por vírgula.
ALLOWED_ORIGINS=http://localhost:5173
